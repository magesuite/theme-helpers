<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="skip.links">
            <arguments>
                <argument name="skip_links_links" xsi:type="array">
                    <item name="link_1" xsi:type="array">
                        <item name="element_id" xsi:type="string">shipping</item>
                        <item name="text" xsi:type="string" translate="true">Skip to main content</item>
                    </item>
                    <item name="link_2" xsi:type="boolean">false</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
