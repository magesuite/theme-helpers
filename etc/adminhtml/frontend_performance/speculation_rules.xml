<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <section id="speculation_rules" translate="label" type="text" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>Speculation Rules</label>
        <tab>magesuite</tab>
        <resource>MageSuite_ThemeHelpers::speculation_rules</resource>
        <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Speculation Rules</label>
            <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                <label>Is Enabled</label>
                <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                <comment>
                    <![CDATA[By enabling this option, the speculation rules JSON containing script will be attached to the website source code. See <a href="https://developer.mozilla.org/en-US/docs/Web/API/Speculation_Rules_API" target="_blank">documentation</a>.]]>
                </comment>
            </field>
            <field id="configuration" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1" type="textarea">
                <label>Speculation Rules JSON</label>
                <depends>
                    <field id="speculation_rules/general/is_enabled">1</field>
                </depends>
                <comment>
                    <![CDATA[<div class="message error">Enter a valid JSON object for speculation rules.</div>]]>
                </comment>
                <validate>required-entry validate-json</validate>
            </field>
        </group>
    </section>
</include>
