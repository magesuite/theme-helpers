{
  "name": "creativestyle/magesuite-theme-helpers",
  "description": "Blocks and helpers required by base theme",
  "type": "magento2-module",
  "homepage": "https://creativestyle.de",
  "license": "OSL-3.0",
  "require": {
    "creativestyle/magesuite-category-icon": "^1.0.0"
  },
  "autoload": {
    "files": [ "registration.php" ],
    "psr-4": {
      "MageSuite\\ThemeHelpers\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
